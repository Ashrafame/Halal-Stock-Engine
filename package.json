{
  "name": "halal-stock-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Sharia-compliant stock screening, alerting and portfolio tracking for web and mobile.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @hse/web",
    "dev:mobile": "npm run start --workspace @hse/mobile",
    "build": "npm run build --workspace @hse/web",
    "build:web": "npm run build --workspace @hse/web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:verify": "vitest run packages/shared/tests/sql-rls.test.ts",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/stripe-webhook/index.ts supabase/functions/stripe-checkout/index.ts supabase/functions/stripe-portal/index.ts supabase/functions/sync-market-data/index.ts supabase/functions/sync-compliance/index.ts supabase/functions/evaluate-alerts/index.ts supabase/functions/admin-api/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "functions:deploy": "supabase functions deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
