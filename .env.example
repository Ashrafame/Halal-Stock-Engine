# ---------------------------------------------------------------------------
# Halal Stock Engine — environment template
# Copy to `.env.local` (web) and `apps/mobile/.env.local`, or use
# `supabase/.env.local` for Edge Functions. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Web (apps/web) ---------------------------------------------------------
# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server-only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Edge Functions (supabase/.env.local) -----------------------------------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase at runtime.
CRON_SECRET=generate-a-long-random-value
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx
APP_URL=http://localhost:3000

# Compliance providers (either may be omitted; the engine falls back to manual)
ZOYA_API_KEY=
ISLAMICLY_API_KEY=
# Optional: `zoya` | `islamicly`. Defaults to `zoya` when a key exists.
COMPLIANCE_PROVIDER=zoya

# Market data: `polygon` | `yahoo` | `alpaca`
MARKET_DATA_PROVIDER=polygon
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Email (Resend) and push (Expo)
RESEND_API_KEY=
ALERT_EMAIL_FROM="Halal Stock Engine <alerts@halalstockengine.app>"
EXPO_PUSH_ACCESS_TOKEN=

# --- Mobile (apps/mobile/.env.local) ---------------------------------------
# Only EXPO_PUBLIC_* values are bundled into the app. Never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://your-project-ref.supabase.co/functions/v1
EXPO_PUBLIC_APP_URL=http://localhost:3000
